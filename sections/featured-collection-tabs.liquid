<div class="fct page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="fct__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <ul class="fct__debug-list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tab_collection = block.settings.collection
        assign tab_label = block.settings.label | default: tab_collection.title | default: 'Chưa chọn collection'
      -%}
      <li {{ block.shopify_attributes }}>
        {{ tab_label | escape }}
      </li>
    {%- endfor -%}
  </ul>
</div>
{% schema %}
{
  "name": "Featured Collection Tabs",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sản phẩm nổi bật"
    },
    {
      "type": "range",
      "id": "products_per_collection",
      "label": "Products per collection",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Collection tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Custom tab label",
          "info": "Để trống sẽ dùng tên collection"
        }
      ]
    }
  ],
  "presets": [
    {
        "name": "Featured Collection Tabs",
        "blocks": [{ "type": "tab" }, { "type": "tab" }, { "type": "tab" }]
    }
  ]
}
{% endschema %}
