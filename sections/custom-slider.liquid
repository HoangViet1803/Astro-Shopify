{{ 'section-custom-slider.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign total = section.blocks.size
  assign slide_role = 'sections.custom_slider.slide_roledescription' | t | escape
  # Danh sách width cho srcset – dùng chung cho image_tag và <source>
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000'
  assign widths_arr = widths | split: ', '
  assign h_mode_d = 'fixed'
  case s.height_desktop
    when 'adapt'
      assign h_mode_d = 'adapt'
    when 'full'
      assign height_d = 'calc(100svh - var(--header-height, 0px))'
    when 'custom'
      assign height_d = s.height_desktop_custom | append: 'svh'
    else
      assign height_d = s.height_desktop | append: 'svh'
  endcase
  assign h_mode_m = 'fixed'
  case s.height_mobile
    when 'adapt'
      assign h_mode_m = 'adapt'
    when 'custom'
      assign height_m = s.height_mobile_custom | append: 'svh'
    else
      assign height_m = s.height_mobile | append: 'svh'
  endcase
  assign first_img_d = section.blocks.first.settings.image
  assign first_img_m = section.blocks.first.settings.image_mobile | default: first_img_d
  assign img_sizes = '100vw'
  if s.width == 'page' and settings.page_width
    assign img_sizes = '(min-width: ' | append: settings.page_width | append: 'px) ' | append: settings.page_width | append: 'px, 100vw'
  endif
  if s.use_heading_font
    assign weight_str = s.heading_weight | append: ''
    assign heading_font = s.heading_font | font_modify: 'weight', weight_str
    if heading_font == nil
      assign heading_font = s.heading_font
    endif
  endif
-%}
{%- if total > 1 -%}
  <script src="{{ 'section-custom-slider.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if s.use_heading_font or s.use_body_font -%}
  <style>
    {%- if s.use_heading_font -%}{{ heading_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if s.use_body_font -%}{{ s.body_font | font_face: font_display: 'swap' }}{%- endif -%}
  </style>
{%- endif -%}
{%- capture section_style -%}
  --cs-pt-m: {{ s.padding_top_mobile }}px; --cs-pb-m: {{ s.padding_bottom_mobile }}px;
  --cs-pt-d: {{ s.padding_top_desktop }}px; --cs-pb-d: {{ s.padding_bottom_desktop }}px;
  --cs-side-margin: {{ s.side_margin }}px;
  {%- if settings.page_width %} --cs-page-width: {{ settings.page_width }}px;{% endif %}
  --cs-radius: {{ s.slider_radius }}px;
  --cs-fit: {{ s.image_fit }};
  {%- if height_d %} --cs-height-d: {{ height_d }};{% endif %}
  {%- if height_m %} --cs-height-m: {{ height_m }};{% endif %}
  {%- if h_mode_d == 'adapt' and first_img_d %} --cs-ratio-d: {{ first_img_d.aspect_ratio }};{% endif %}
  {%- if h_mode_m == 'adapt' and first_img_m %} --cs-ratio-m: {{ first_img_m.aspect_ratio }};{% endif %}
  {%- if s.use_heading_font %} --cs-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};{% endif %}
  {%- if s.use_body_font %} --cs-body-font: {{ s.body_font.family }}, {{ s.body_font.fallback_families }};{% endif %}
  --cs-heading-size-m: {{ s.heading_size_mobile }}px; --cs-heading-size-d: {{ s.heading_size_desktop }}px;
  --cs-sub-size-m: {{ s.subheading_size_mobile }}px; --cs-sub-size-d: {{ s.subheading_size_desktop }}px;
  --cs-text-size-m: {{ s.text_size_mobile }}px; --cs-text-size-d: {{ s.text_size_desktop }}px;
  --cs-heading-weight: {{ s.heading_weight }};
  --cs-heading-ls: {{ s.heading_letter_spacing | divided_by: 100.0 }}em;
  --cs-heading-lh: {{ s.heading_line_height | divided_by: 100.0 }};
  --cs-sub-transform: {% if s.subheading_uppercase %}uppercase{% else %}none{% endif %};
  --cs-gap: {{ s.content_gap }}px;
  --cs-content-max: {{ s.content_max_width }}%;
  --cs-content-pad: {{ s.content_padding }}px;
  --cs-content-radius: {{ s.content_radius }}px;
  --cs-btn-radius: {{ s.button_radius }}px; --cs-btn-border-w: {{ s.button_border_width }}px;
  --cs-btn-px: {{ s.button_padding_x }}px; --cs-btn-py: {{ s.button_padding_y }}px;
  --cs-btn-size: {{ s.button_font_size }}px;
  --cs-duration: {{ s.transition_duration }}ms; --cs-easing: {{ s.transition_easing }};
  --cs-autoplay-speed: {{ s.autoplay_speed | times: 1000 }}ms;
  --cs-anim-duration: {{ s.content_animation_duration }}ms;
  --cs-anim-delay: {{ s.content_animation_delay }}ms;
  --cs-arrow-color: {{ s.arrow_color }}; --cs-arrow-bg: {{ s.arrow_bg }};
  --cs-arrow-size: {{ s.arrow_size }}px; --cs-arrow-radius: {{ s.arrow_radius }}px;
  --cs-dot-color: {{ s.dot_color }}; --cs-dot-active: {{ s.dot_active_color }};
  --cs-dot-size: {{ s.dot_size }}px;
{%- endcapture -%}
<div class="cs-section color-{{ s.color_scheme }} gradient" style="{{ section_style | strip_newlines | strip }}" data-cs-hover="{{ s.button_hover }}">
  <div class="cs-container{% if s.width == 'page' %} cs-container--page{% endif %}">
    {%- if total > 0 -%}
      <custom-slider class="cs-slider" role="region" aria-roledescription="{{ 'sections.custom_slider.carousel_roledescription' | t | escape }}" aria-label="{{ 'sections.custom_slider.carousel_label' | t | escape }}" data-transition="{{ s.transition }}" data-autoplay="{{ s.autoplay }}" data-speed="{{ s.autoplay_speed }}" data-pause-hover="{{ s.pause_on_hover }}" data-stop-on-interaction="{{ s.stop_on_interaction }}" data-loop="{{ s.loop }}" data-swipe-threshold="{{ s.swipe_threshold }}" data-label-slide="{{ 'sections.custom_slider.slide_label' | t: current: '[current]', total: total | escape }}" data-label-counter="{{ 'sections.custom_slider.counter' | t: current: '[current]', total: total | escape }}" data-label-play="{{ 'sections.custom_slider.play' | t | escape }}" data-label-pause="{{ 'sections.custom_slider.pause' | t | escape }}" data-arrows-pos="{{ s.arrow_position }}" data-arrows-hide-m="{{ s.arrow_hide_mobile }}" data-nav-pos="{{ s.nav_position }}" data-mobile-nav="{{ s.mobile_nav }}" data-dot-style="{{ s.dot_style }}" {% if s.content_animation != 'none' %} data-anim="{{ s.content_animation }}" {% endif %} >
        {%- if total > 1 -%}
          {%- if s.autoplay or s.show_dots or s.show_counter -%}
            <div class="cs-nav">
              {%- if s.autoplay -%}
                <button type="button" class="cs-play" data-cs-play data-state="playing" aria-label="{{ 'sections.custom_slider.pause' | t | escape }}">
                  <svg class="cs-play__icon cs-play__icon--pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14M16 5v14"/></svg>
                  <svg class="cs-play__icon cs-play__icon--play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5l11 7-11 7z"/></svg>
                </button>
              {%- endif -%}
              {%- if s.show_dots -%}
                <div class="cs-dots">
                  {%- for block in section.blocks -%}
                    <button type="button" class="cs-dot" data-cs-dot="{{ forloop.index0 }}" aria-label="{{ 'sections.custom_slider.go_to_slide' | t: number: forloop.index | escape }}" {% if forloop.first %}aria-current="true"{% endif %}>
                      <span class="cs-dot__bar"><span class="cs-dot__fill"></span></span>
                    </button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              {%- if s.show_counter -%}
                <p class="cs-counter" data-cs-counter aria-hidden="true"> {{- 'sections.custom_slider.counter' | t: current: 1, total: total -}} </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}
        <div class="cs-viewport" data-h-m="{{ h_mode_m }}" data-h-d="{{ h_mode_d }}">
          {%- if total > 1 and s.show_arrows -%}
            <button type="button" class="cs-arrow cs-arrow--prev" data-cs-prev aria-label="{{ 'sections.custom_slider.previous' | t | escape }}">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg>
            </button>
            <button type="button" class="cs-arrow cs-arrow--next" data-cs-next aria-label="{{ 'sections.custom_slider.next' | t | escape }}">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg>
            </button>
          {%- endif -%}
          <div class="cs-track" data-cs-track>
             {%- for block in section.blocks -%}
                {%- liquid
                  assign b = block.settings
                  assign img_d = b.image
                  assign img_m = b.image_mobile | default: img_d
                  assign has_text = false
                  assign heading_plain = ''
                  if b.show_text
                    assign heading_plain = b.heading | strip_html | strip
                    if b.subheading != blank or b.heading != blank or b.text != blank
                      assign has_text = true
                    endif
                  endif
                  assign alt = img_d.alt | default: heading_plain
                  assign button_count = b.button_count | plus: 0
                  assign use_slide_link = false
                  if button_count == 0 and b.slide_link != blank
                    assign use_slide_link = true
                    assign link_fallback = 'sections.custom_slider.slide_link' | t: number: forloop.index
                    assign link_label = alt | default: link_fallback
                  endif
                -%}
                {%- capture buttons_html -%}
                  {%- if button_count > 0 -%}
                    {%- for n in (1..button_count) -%}
                      {%- liquid
                        assign key_label = 'button_' | append: n | append: '_label'
                        assign key_link = 'button_' | append: n | append: '_link'
                        assign key_style = 'button_' | append: n | append: '_style'
                        assign key_tab = 'button_' | append: n | append: '_new_tab'
                      -%}
                      {%- if b[key_label] != blank and b[key_link] != blank -%}
                        <a class="cs-btn cs-btn--{{ b[key_style] }}" href="{{ b[key_link] }}"
                          {% if b[key_tab] %}target="_blank" rel="noopener"{% endif %}>
                            {{- b[key_label] | escape -}}
                          {%- if b[key_tab] -%}
                            <span class="cs-visually-hidden"> {{ 'sections.custom_slider.new_tab' | t }}</span>
                          {%- endif -%}
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                {%- endcapture -%}
                {%- liquid
                  assign has_buttons = false
                  if buttons_html != blank
                    assign has_buttons = true
                  endif
                  assign has_content = false
                  if has_text or has_buttons
                    assign has_content = true
                  endif
                  assign boxed = false
                  if has_text and b.show_content_bg
                    assign boxed = true
                    assign box_alpha = b.content_bg_opacity | divided_by: 100.0
                  endif
                  assign heading_tag = 'h2'
                  assign loading = 'lazy'
                  assign priority = 'auto'
                  if forloop.first
                    assign heading_tag = s.first_heading_tag
                    if section.index == 1 or section.index == nil
                      assign loading = 'eager'
                      assign priority = 'high'
                    elsif section.index == 2
                      assign loading = 'eager'
                    endif
                  endif
                  assign pos_d = b.position_desktop | split: '-'
                  assign v_d = pos_d.first | replace: 'top', 'flex-start' | replace: 'middle', 'center' | replace: 'bottom', 'flex-end'
                  assign h_d = pos_d.last | replace: 'left', 'flex-start' | replace: 'right', 'flex-end'
                  assign j_d = b.text_align_desktop | replace: 'left', 'flex-start' | replace: 'right', 'flex-end'
                  assign v_m = b.position_mobile | replace: 'top', 'flex-start' | replace: 'middle', 'center' | replace: 'bottom', 'flex-end'
                  assign h_m = b.text_align_mobile | replace: 'left', 'flex-start' | replace: 'right', 'flex-end'
                  assign i = 0
                -%}
                {%- capture slide_style -%}
                  --cs-overlay-color: {{ b.overlay_color }};
                  --cs-overlay-opacity: {{ b.overlay_opacity | divided_by: 100.0 }};
                  --cs-v-m: {{ v_m }}; --cs-h-m: {{ h_m }}; --cs-align-m: {{ b.text_align_mobile }};
                  --cs-v-d: {{ v_d }}; --cs-h-d: {{ h_d }}; --cs-align-d: {{ b.text_align_desktop }}; --cs-justify-d: {{ j_d }};
                  {%- if img_d %} --cs-focal-d: {{ img_d.presentation.focal_point }}; --cs-focal-m: {{ img_m.presentation.focal_point }};{% endif %}
                  {%- if b.use_custom_colors %}
                    {%- if has_text %}
                      --cs-heading-color: {{ b.heading_color }}; --cs-sub-color: {{ b.subheading_color }};
                      --cs-text-color: {{ b.text_color }};
                    {%- endif %}
                    {%- if has_buttons %}
                      --cs-btn-bg: {{ b.button_bg }}; --cs-btn-text: {{ b.button_text }};
                      --cs-btn-border: {{ b.button_border }}; --cs-btn-hover: {{ b.button_hover }};
                    {%- endif %}
                  {%- endif %}
                  {%- if boxed %} --cs-box-bg: {{ b.content_bg | color_modify: 'alpha', box_alpha }};{% endif %}
                {%- endcapture -%}
                <div class="cs-slide{% if forloop.first %} is-active{% endif %}{% if use_slide_link %} cs-slide--linked{% endif %}" role="group" aria-roledescription="{{ slide_role }}" aria-label="{{ 'sections.custom_slider.slide_label' | t: current: forloop.index, total: total | escape }}" tabindex="-1" data-cs-slide style="{{ slide_style | strip_newlines | strip }}" {{ block.shopify_attributes }} >
                  {%- if use_slide_link -%}
                    <a class="cs-media" href="{{ b.slide_link }}" aria-label="{{ link_label | escape }}">
                  {%- else -%}
                    <div class="cs-media">
                  {%- endif -%}
                  {%- if img_d != blank -%}
                    <picture>
                      {%- if b.image_mobile != blank -%}
                        {%- capture srcset_m -%}
                          {%- for w in widths_arr -%}
                            {%- assign wn = w | plus: 0 -%}
                            {%- if wn < img_m.width -%}{{ img_m | image_url: width: wn }} {{ wn }}w,{%- endif -%}
                          {%- endfor -%}
                          {{- img_m | image_url: width: img_m.width }} {{ img_m.width }}w
                        {%- endcapture -%}
                        <source media="(max-width: 749px)" srcset="{{ srcset_m }}" sizes="100vw" width="{{ img_m.width }}" height="{{ img_m.height }}">
                      {%- endif -%}
                      {{ img_d | image_url: width: 3000 | image_tag:
                        widths: widths,
                        sizes: img_sizes,
                        loading: loading,
                        fetchpriority: priority,
                        alt: alt,
                        class: 'cs-media__img',
                        draggable: 'false'
                      }}
                    </picture>
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'cs-media__img cs-media__placeholder' }}
                  {%- endif -%}
                  {%- if b.overlay_opacity > 0 -%}<span class="cs-overlay" aria-hidden="true"></span>{%- endif -%}
                  {%- if use_slide_link -%}</a>{%- else -%}</div>{%- endif -%}
                  {%- if has_content -%}
                    <div class="cs-slide__inner">
                      <div class="cs-content{% if boxed %} cs-content--boxed{% endif %}">
                        {%- if has_text -%}
                          {%- if b.subheading != blank -%}
                            <p class="cs-subheading" style="--i: {{ i }}">{{ b.subheading | escape }}</p>
                            {%- assign i = i | plus: 1 -%}
                          {%- endif -%}
                          {%- if b.heading != blank -%}
                            <{{ heading_tag }} class="cs-heading" style="--i: {{ i }}">{{ b.heading }}</{{ heading_tag }}>
                            {%- assign i = i | plus: 1 -%}
                          {%- endif -%}
                          {%- if b.text != blank -%}
                            <div class="cs-text" style="--i: {{ i }}">{{ b.text }}</div>
                            {%- assign i = i | plus: 1 -%}
                          {%- endif -%}
                        {%- endif -%}
                        {%- if has_buttons -%}
                          <div class="cs-buttons" style="--i: {{ i }}">{{ buttons_html }}</div>
                        {%- endif -%}
                      </div>
                    </div>
                    {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
        </div>
          {%- if total > 1 -%}
            <div class="cs-visually-hidden" data-cs-live aria-live="polite" aria-atomic="true"></div>
          {%- endif -%}
      </custom-slider>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "t:sections.custom_slider.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 5,
  "settings": [
    { "type": "header", "content": "t:sections.custom_slider.headers.layout" },
    { "type": "select", "id": "width", "label": "t:sections.custom_slider.settings.width.label",
      "options": [
        { "value": "full", "label": "t:sections.custom_slider.options.full_width" },
        { "value": "page", "label": "t:sections.custom_slider.options.page_width" }
      ], "default": "full" },
    { "type": "select", "id": "height_desktop", "label": "t:sections.custom_slider.settings.height_desktop.label",
      "options": [
        { "value": "adapt", "label": "t:sections.custom_slider.options.adapt" },
        { "value": "40", "label": "t:sections.custom_slider.options.small" },
        { "value": "60", "label": "t:sections.custom_slider.options.medium" },
        { "value": "80", "label": "t:sections.custom_slider.options.large" },
        { "value": "full", "label": "t:sections.custom_slider.options.full_screen" },
        { "value": "custom", "label": "t:sections.custom_slider.options.custom" }
      ], "default": "60" },
    { "type": "range", "id": "height_desktop_custom", "min": 30, "max": 100, "step": 5, "unit": "vh", "default": 70,
      "label": "t:sections.custom_slider.settings.height_desktop_custom.label",
      "info": "t:sections.custom_slider.settings.height_desktop_custom.info",
      "visible_if": "{{ section.settings.height_desktop == 'custom' }}" },
    { "type": "select", "id": "height_mobile", "label": "t:sections.custom_slider.settings.height_mobile.label",
      "options": [
        { "value": "adapt", "label": "t:sections.custom_slider.options.adapt" },
        { "value": "40", "label": "t:sections.custom_slider.options.small" },
        { "value": "60", "label": "t:sections.custom_slider.options.medium" },
        { "value": "80", "label": "t:sections.custom_slider.options.large" },
        { "value": "custom", "label": "t:sections.custom_slider.options.custom" }
      ], "default": "60" },
    { "type": "range", "id": "height_mobile_custom", "min": 30, "max": 100, "step": 5, "unit": "vh", "default": 60,
      "label": "t:sections.custom_slider.settings.height_mobile_custom.label",
      "info": "t:sections.custom_slider.settings.height_mobile_custom.info",
      "visible_if": "{{ section.settings.height_mobile == 'custom' }}" },
    { "type": "select", "id": "image_fit", "label": "t:sections.custom_slider.settings.image_fit.label",
      "options": [
        { "value": "cover", "label": "t:sections.custom_slider.options.cover" },
        { "value": "contain", "label": "t:sections.custom_slider.options.contain" }
      ], "default": "cover" },
    { "type": "range", "id": "slider_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0, "label": "t:sections.custom_slider.settings.slider_radius.label" },
    { "type": "range", "id": "side_margin", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0, "label": "t:sections.custom_slider.settings.side_margin.label" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0, "label": "t:sections.custom_slider.settings.padding_top_desktop.label" },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0, "label": "t:sections.custom_slider.settings.padding_bottom_desktop.label" },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0, "label": "t:sections.custom_slider.settings.padding_top_mobile.label" },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0, "label": "t:sections.custom_slider.settings.padding_bottom_mobile.label" },

    { "type": "header", "content": "t:sections.custom_slider.headers.colors" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1",
      "label": "t:sections.custom_slider.settings.color_scheme.label",
      "info": "t:sections.custom_slider.settings.color_scheme.info" },

    { "type": "header", "content": "t:sections.custom_slider.headers.typography" },
    { "type": "checkbox", "id": "use_heading_font", "default": false, "label": "t:sections.custom_slider.settings.use_heading_font.label" },
    { "type": "font_picker", "id": "heading_font", "default": "assistant_n4", "label": "t:sections.custom_slider.settings.heading_font.label",
      "visible_if": "{{ section.settings.use_heading_font }}" },
    { "type": "checkbox", "id": "use_body_font", "default": false, "label": "t:sections.custom_slider.settings.use_body_font.label" },
    { "type": "font_picker", "id": "body_font", "default": "assistant_n4", "label": "t:sections.custom_slider.settings.body_font.label",
      "visible_if": "{{ section.settings.use_body_font }}" },
    { "type": "range", "id": "heading_size_desktop", "min": 24, "max": 96, "step": 2, "unit": "px", "default": 56, "label": "t:sections.custom_slider.settings.heading_size_desktop.label" },
    { "type": "range", "id": "heading_size_mobile", "min": 18, "max": 56, "step": 2, "unit": "px", "default": 32, "label": "t:sections.custom_slider.settings.heading_size_mobile.label" },
    { "type": "range", "id": "subheading_size_desktop", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 14, "label": "t:sections.custom_slider.settings.subheading_size_desktop.label" },
    { "type": "range", "id": "subheading_size_mobile", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12, "label": "t:sections.custom_slider.settings.subheading_size_mobile.label" },
    { "type": "range", "id": "text_size_desktop", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 18, "label": "t:sections.custom_slider.settings.text_size_desktop.label" },
    { "type": "range", "id": "text_size_mobile", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 15, "label": "t:sections.custom_slider.settings.text_size_mobile.label" },
    { "type": "range", "id": "heading_weight", "min": 300, "max": 900, "step": 100, "default": 700, "label": "t:sections.custom_slider.settings.heading_weight.label" },
    { "type": "range", "id": "heading_letter_spacing", "min": -5, "max": 30, "step": 1, "unit": "%", "default": 0, "label": "t:sections.custom_slider.settings.heading_letter_spacing.label" },
    { "type": "range", "id": "heading_line_height", "min": 80, "max": 200, "step": 5, "unit": "%", "default": 110, "label": "t:sections.custom_slider.settings.heading_line_height.label" },
    { "type": "checkbox", "id": "subheading_uppercase", "default": true, "label": "t:sections.custom_slider.settings.subheading_uppercase.label" },
    { "type": "select", "id": "first_heading_tag", "label": "t:sections.custom_slider.settings.first_heading_tag.label",
      "info": "t:sections.custom_slider.settings.first_heading_tag.info",
      "options": [
        { "value": "h1", "label": "t:sections.custom_slider.options.h1" },
